# Puerto en el que corre la API
PORT=3000

# Entorno de ejecución: development | production | test
NODE_ENV=development

# Cadena de conexión a PostgreSQL usada por Prisma
# Formato: postgresql://USUARIO:PASSWORD@HOST:PUERTO/BASE_DE_DATOS?schema=public
DATABASE_URL="postgresql://postgres:123456@localhost:5432/pedidos?schema=public"

# Origen(es) permitidos para CORS (separados por coma). Usa * para permitir todos.
CORS_ORIGIN=*
